# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic — BOL extraction
ANTHROPIC_API_KEY=

# Google Connect (server-only — never NEXT_PUBLIC_)
# See docs/google-oauth-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# 32-byte key, base64-encoded: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Browser API key with Google Picker API enabled (server-read for picker session)
GOOGLE_API_KEY=
# Optional Cloud project number for Picker setAppId
GOOGLE_APP_ID=
SUPABASE_SERVICE_ROLE_KEY=
